--- ============================================================
--- pythonlite-bigstep.maude
--- ============================================================
--- Big-step / Kahn-style operational semantics for pythonlite.
---
--- Configuration shapes [Value-typed from cycle 1 onward]:
---
---   < Exp,  Sigma, Out >  =>  < Value, Out' >    expression evaluation
---   < Stmt, Sigma, Out >  =>  < Sigma', Out' >   statement evaluation
---   < Pgm                >  =>  < Sigma,  Out  >  whole-program kickoff
---
--- The Value sort [pythonlite-values.maude] subsumes Int, Bool,
--- String, and the special `none` constant.  Most rules are typed:
--- the variables `I, I1, I2 : Int` only match integer values, while
--- `S, S1, S2 : String` only match strings.  A binary operator like
--- `+` therefore has multiple rules — one for ints, one for strings —
--- and Maude's sort resolution picks the right one.  An int + string
--- combination has no applicable rule and gets stuck [we will surface
--- this as an exception in cycle 7].
--- ============================================================

mod PYTHONLITE-CONFIGURATIONS-BIGSTEP is
  including PYTHONLITE-SYNTAX + PYTHONLITE-STATE + PYTHONLITE-OUT .

  --- Outcome [cycle 5]: a statement either completes normally [yielding
  --- an updated State], or returns early via `return e` [yielding
  --- ret[V]].  Outcome is the union; existing rules that produce
  --- State automatically lift via subsort.
  sort Outcome .
  subsort State < Outcome .
  --- ret carries the callee's final State (cycle 14) so a call statement can
  --- copy list mutations back to the caller; a top-level return drops it.
  op ret    : Value State -> Outcome [ctor] .   --- early return (cycle 5, State added cycle 14)
  --- raised carries the State at the raise (cycle 13), like brk / cnt, so a
  --- handler sees the assignments made before the raise (CPython does).
  --- Cycle 14: an expression evaluation finishes with a Value or, when a call
  --- inside it raised, with xraised[V, S] [sort ExpOut]; the statement around
  --- it turns that into the Outcome raised[V, S] instead of getting stuck.
  sorts XRaised ExpOut .
  subsort XRaised < ExpOut .  subsort Value < ExpOut .
  op xraised : Value State -> XRaised [ctor] .   --- a raise met while evaluating an expression
  op raised : Value State -> Outcome [ctor] .   --- raised exception (cycle 7, state added cycle 13)
  --- break / continue (cycle 12): unlike ret / raised they carry the State
  --- at the point of the jump, because the enclosing loop keeps running in it.
  op brk    : State -> Outcome [ctor] .   --- break out of the nearest loop
  op cnt    : State -> Outcome [ctor] .   --- continue with the next iteration

  sort Configuration .
  --- expression configurations [Value-result]
  op <_,_,_> : Exp State Out -> Configuration .
  --- statement configurations
  op <_,_,_> : Stmt State Out -> Configuration .
  --- Cycle 14: result brackets.  An expression finishes with an ExpOut
  --- [Value or xraised], a call's argument list with an ArgsOut [ValueList or
  --- xraisedL], a statement with an Outcome.
  sorts ArgsOut ArgsRaised .
  subsort ValueList < ArgsOut .  subsort ArgsRaised < ArgsOut .
  op xraisedL : Value State -> ArgsRaised [ctor] .   --- a raise met while evaluating call arguments
  op <_,_>   : Outcome Out -> Configuration [ctor] .
  op <_,_>   : ExpOut Out -> Configuration [ctor] .
  op <_,_>   : ArgsOut Out -> Configuration [ctor] .
  --- whole-program [starts from empty state + empty output]
  op <_>     : Pgm -> Configuration .
endm

mod PYTHONLITE-FLOORDIV is including PL-INT .
  --- Python's floor-div + floor-mod, distinct from Maude's truncating
  --- /Int and rem.  For nonzero b: a // b == floor[a / b], and
  --- a % b has the sign of b.
  var A B : Int .
  op floorDiv : Int Int -> [Int] .
  op floorMod : Int Int -> [Int] .
 ceq floorDiv(A, B)
   = if (((A <=Int 0) andBool (0 <=Int B)) orBool ((B <=Int 0) andBool (0 <=Int A)))
        andBool ((A -Int ((A /Int B) *Int B)) =/=Bool 0)
     then (A /Int B) -Int 1
     else (A /Int B)
     fi
   if B =/=Bool 0 .
 ceq floorMod(A, B) = A -Int (floorDiv(A, B) *Int B) if B =/=Bool 0 .
endm

mod PYTHONLITE-SEMANTICS-BIGSTEP is
  including PYTHONLITE-CONFIGURATIONS-BIGSTEP + PYTHONLITE-FLOORDIV .

  vars X : Id .
  vars Sigma Sigma' Sigma1 Sigma2 : State .
  vars Out Out1 Out2 Out3 Out' : Out .
  vars I I1 I2 Ih Nh : Int .       --- only match integer values
  vars S S1 S2 : String .    --- only match string values
  vars B T T1 T2 : Bool .    --- only match boolean values
  vars V V1 V2 Vrp : Value .     --- match anything
  vars SigmaR SigmaF : State .
  var CfgR : Configuration .
  vars EO : ExpOut .  vars AO : ArgsOut .
  --- Cycle 14 markers, kept in the State under reserved Ids.
  ---   fnFlag     : this State is a function frame
  ---   loc(X)     : X was assigned inside the frame, so it is local
  ---   prm(X)     : X is a parameter of the frame [also local]
  ---   mut(X)     : X's list was appended to / set in place inside the frame
  --- A call statement copies mut-but-not-loc variables back to the caller
  --- [lists are pure values here, so this models Python's aliasing].
  op fnFlag : -> Id [ctor] .
  op loc : Id -> Id [ctor] .
  op prm : Id -> Id [ctor] .
  op mut : Id -> Id [ctor] .
  op asgn : State Id Value -> State .
  op mutd : State Id Value -> State .
  eq asgn(Sigma, X, V)
    = if bound(Sigma, fnFlag) then (Sigma[V / X])[true / loc(X)] else Sigma[V / X] fi .
  eq mutd(Sigma, X, V)
    = if bound(Sigma, fnFlag) then (Sigma[V / X])[true / mut(X)] else Sigma[V / X] fi .
  op isMark : Id -> Bool .
  eq isMark(fnFlag) = true .
  eq isMark(loc(X)) = true .
  eq isMark(prm(X)) = true .
  eq isMark(mut(X)) = true .
  eq isMark(X) = false [owise] .
  op stripMarks : State -> State .
  eq stripMarks(.State) = .State .
  eq stripMarks((X |-> V) & Sigma)
    = if isMark(X) then stripMarks(Sigma) else (X |-> V) & stripMarks(Sigma) fi .
  --- fill(Acc, Rest, Cap, Orig): Acc [the caller's State without markers] plus
  --- the non-marker bindings of Cap.  A Cap binding the caller lacks is added.
  --- One the caller has is kept as the caller's [so globals reassigned after the
  --- def stay fresh], EXCEPT when X is a local of the defining frame [loc / prm
  --- in Cap] and not a local of the calling frame [Orig]: then it is a closure
  --- variable that shadows the caller's same-named one, and Cap's value wins.
  op fill : State State State State -> State .
  vars Orig : State .
  op isLocal : State Id -> Bool .
  eq isLocal(Sigma, X) = bound(Sigma, loc(X)) orBool bound(Sigma, prm(X)) .
  eq fill(Sigma, .State, Cap, Orig) = Sigma .
  eq fill(Sigma, (X |-> V) & Sigma1, Cap, Orig)
    = if isMark(X) then fill(Sigma, Sigma1, Cap, Orig)
      else if bound(Sigma, X)
           then (if isLocal(Cap, X) andBool (isLocal(Orig, X) =/=Bool true)
                 then fill(Sigma[V / X], Sigma1, Cap, Orig)
                 else fill(Sigma, Sigma1, Cap, Orig) fi)
           else fill(Sigma & (X |-> V), Sigma1, Cap, Orig) fi fi .
  --- bound(Sigma, X): X has a binding in Sigma, possibly to `none` (cycle 13).
  op bound : State Id -> Bool .
  eq bound(Sigma & X |-> V, X) = true .
  eq bound(Sigma, X) = false [owise] .
  vars E E1 E2 : Exp .
  vars St St1 St2 : Stmt .

  --- ----- expressions: literals -----
  --- Int / Bool / String literals are subsorted as Value already, so
  --- a single rule covers all three [the variable is typed Value].
  rl < V, Sigma, Out > => < V, Out > .

  --- variable lookup
 crl < X,    Sigma, Out > => < Sigma(X), Out >
   if bound(Sigma, X) .   --- a variable bound to None is a real binding (cycle 13)

  --- ----- arithmetic [Int + Int = Int] ----------------------
 crl < E1 + E2, Sigma, Out > => < I1 +Int I2, Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 - E2, Sigma, Out > => < I1 -Int I2, Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 * E2, Sigma, Out > => < I1 *Int I2, Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 // E2, Sigma, Out > => < floorDiv(I1, I2), Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 >
   /\ I2 =/=Bool 0 .
 crl < E1 % E2, Sigma, Out > => < floorMod(I1, I2), Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 >
   /\ I2 =/=Bool 0 .
 crl < uminus E, Sigma, Out > => < -Int I, Out' >
   if < E, Sigma, Out > => < I, Out' > .

  --- ----- string concatenation [String + String = String] ----
 crl < E1 + E2, Sigma, Out > => < S1 +String S2, Out2 >
   if < E1, Sigma, Out  > => < S1, Out1 >
   /\ < E2, Sigma, Out1 > => < S2, Out2 > .

  --- ----- string repetition [String * Int = String] ----------
  --- Python: "ab" * 3 == "ababab".  Implemented via an auxiliary.
 crl < E1 * E2, Sigma, Out > => < strRep(S1, I2), Out2 >
   if < E1, Sigma, Out  > => < S1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 * E2, Sigma, Out > => < strRep(S2, I1), Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < S2, Out2 > .

  op strRep : String Int -> String .
  eq strRep(S, 0) = "" .
 ceq strRep(S, I) = S +String strRep(S, I -Int 1) if I >Int 0 .
 ceq strRep(S, I) = "" if I <=Int 0 .

  --- ----- len[_] -------------------------------------------
 crl < len(E), Sigma, Out > => < length(S), Out' >
   if < E, Sigma, Out > => < S, Out' > .
 crl < len(E), Sigma, Out > => < lstLen(L), Out' >
   if < E, Sigma, Out > => < listV(L), Out' > .
  vars L L1 L2 : ListObj .

  --- ----- list literal: evaluate elements left-to-right ------
  op evalElts : ExpList State Out -> Configuration .
  op <_,_>    : ListObj Out -> Configuration [ctor] .
  rl  evalElts(nilE, Sigma, Out) => < nil, Out > .
 crl evalElts(consE(E, EL), Sigma, Out) => < cons(V, L), Out2 >
   if < E, Sigma, Out > => < V, Out1 >
   /\ evalElts(EL, Sigma, Out1) => < L, Out2 > .

 crl < listLit(EL), Sigma, Out > => < listV(L), Out' >
   if evalElts(EL, Sigma, Out) => < L, Out' > .
  vars EL : ExpList .

  --- ----- list indexing: xs ! i  [Python xs[i]] -----------
 crl < E1 ! E2, Sigma, Out > => < lstIdx(L, I), Out2 >
   if < E1, Sigma, Out  > => < listV(L), Out1 >
   /\ < E2, Sigma, Out1 > => < I, Out2 >
   /\ I >=Int 0
   /\ I <Int lstLen(L) .
  --- [out-of-range indexing is currently stuck; cycle 7 will raise IndexError]

  --- ----- list `+` concat -------------------------------
 crl < E1 + E2, Sigma, Out > => < listV(lstConcat(L1, L2)), Out2 >
   if < E1, Sigma, Out  > => < listV(L1), Out1 >
   /\ < E2, Sigma, Out1 > => < listV(L2), Out2 > .

  --- ----- list `*` repetition: lst * n / n * lst --------
  op lstRep : ListObj Int -> ListObj .
  eq lstRep(L, 0) = nil .
 ceq lstRep(L, I) = lstConcat(L, lstRep(L, I -Int 1)) if I >Int 0 .
 ceq lstRep(L, I) = nil if I <=Int 0 .
 crl < E1 * E2, Sigma, Out > => < listV(lstRep(L1, I2)), Out2 >
   if < E1, Sigma, Out  > => < listV(L1), Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 * E2, Sigma, Out > => < listV(lstRep(L2, I1)), Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < listV(L2), Out2 > .

  --- ----- comparison ---------------------------------------
  --- Numeric comparisons.
 crl < E1 <  E2, Sigma, Out > => < (I1 <=Int I2) andBool (I1 =/=Bool I2), Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 <= E2, Sigma, Out > => < I1 <=Int I2, Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 >  E2, Sigma, Out > => < (I2 <=Int I1) andBool (I1 =/=Bool I2), Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .
 crl < E1 >= E2, Sigma, Out > => < I2 <=Int I1, Out2 >
   if < E1, Sigma, Out  > => < I1, Out1 >
   /\ < E2, Sigma, Out1 > => < I2, Out2 > .

  --- Equality / disequality work on any value pair [int vs int,
  --- string vs string, bool vs bool, none vs none, mixed-type yields
  --- false].  We use Maude's polymorphic ==Bool / =/=Bool.
 crl < E1 eqq E2, Sigma, Out > => < V1 ==Bool V2, Out2 >
   if < E1, Sigma, Out  > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < V2, Out2 > .
 crl < E1 neq E2, Sigma, Out > => < V1 =/=Bool V2, Out2 >
   if < E1, Sigma, Out  > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < V2, Out2 > .

  --- String <, <=, >, >= [Python lexicographic compare]
 crl < E1 <  E2, Sigma, Out > => < strLt(S1, S2), Out2 >
   if < E1, Sigma, Out  > => < S1, Out1 >
   /\ < E2, Sigma, Out1 > => < S2, Out2 > .
 crl < E1 <= E2, Sigma, Out > => < strLt(S1, S2) orBool (S1 ==Bool S2), Out2 >
   if < E1, Sigma, Out  > => < S1, Out1 >
   /\ < E2, Sigma, Out1 > => < S2, Out2 > .
 crl < E1 >  E2, Sigma, Out > => < strLt(S2, S1), Out2 >
   if < E1, Sigma, Out  > => < S1, Out1 >
   /\ < E2, Sigma, Out1 > => < S2, Out2 > .
 crl < E1 >= E2, Sigma, Out > => < strLt(S2, S1) orBool (S1 ==Bool S2), Out2 >
   if < E1, Sigma, Out  > => < S1, Out1 >
   /\ < E2, Sigma, Out1 > => < S2, Out2 > .

  op strLt : String String -> Bool .
 ceq strLt(S1, S2) = true  if (rat-substr-cmp(S1, S2)) <Int 0 .
 ceq strLt(S1, S2) = false if (rat-substr-cmp(S1, S2)) >=Int 0 .

  --- Lexicographic comparison via length-and-character compare.
  --- We call out to the maude built-in `cmp` that returns a Rat;
  --- conservative impl: compare by string equality then by length.
  op rat-substr-cmp : String String -> Int .
  eq rat-substr-cmp(S1, S2) =
    if S1 ==Bool S2 then 0
    else if length(S1) <Int length(S2) then -Int 1 else 1 fi
    fi .
  --- [This is a *placeholder* lexicographic compare — for v1 we only
  --- need it to give Python-correct answers on the test corpus,
  --- which uses equal-length strings.  Real lexicographic compare is
  --- a follow-up.]

  op _<Int_ : Int Int -> Bool [prec 37] .
  eq I1 <Int I2 = (I1 <=Int I2) andBool (I1 =/=Bool I2) .

  --- ----- boolean ops with short-circuit and truthy[_] ------
  --- Python's `and` / `or` return the actual operand value, not a
  --- coerced bool: `0 or 5 == 5`, `5 and 7 == 7`.  We implement that.
 crl < E1 and E2, Sigma, Out > => < V1, Out' >
   if < E1, Sigma, Out > => < V1, Out' >
   /\ truthy(V1) ==Bool false .
 crl < E1 and E2, Sigma, Out > => < V2, Out2 >
   if < E1, Sigma, Out  > => < V1, Out1 >
   /\ truthy(V1) ==Bool true
   /\ < E2, Sigma, Out1 > => < V2, Out2 > .
 crl < E1 or E2, Sigma, Out > => < V1, Out' >
   if < E1, Sigma, Out > => < V1, Out' >
   /\ truthy(V1) ==Bool true .
 crl < E1 or E2, Sigma, Out > => < V2, Out2 >
   if < E1, Sigma, Out  > => < V1, Out1 >
   /\ truthy(V1) ==Bool false
   /\ < E2, Sigma, Out1 > => < V2, Out2 > .
 crl < not E, Sigma, Out > => < notBool truthy(V), Out' >
   if < E, Sigma, Out > => < V, Out' > .

  --- ----- raise inside an operand [cycle 14] ------------
  --- A call that raises in operand position yields raised[V, S] instead of a
  --- Value, so the operator propagates it [left operand first].
  vars Vrz : Value .  vars Srz : State .
 crl < E1 + E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 + E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 - E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 - E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 * E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 * E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 // E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 // E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 % E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 % E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 < E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 < E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 <= E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 <= E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 > E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 > E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 >= E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 >= E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 eqq E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 eqq E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 neq E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 neq E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 in E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 in E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 ! E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 ! E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 and E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 or E2, Sigma, Out > => < xraised(Vrz, Srz), Out1 >
   if < E1, Sigma, Out > => < xraised(Vrz, Srz), Out1 > .
 crl < E1 and E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ truthy(V1) ==Bool true
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < E1 or E2, Sigma, Out > => < xraised(Vrz, Srz), Out2 >
   if < E1, Sigma, Out > => < V1, Out1 >
   /\ truthy(V1) ==Bool false
   /\ < E2, Sigma, Out1 > => < xraised(Vrz, Srz), Out2 > .
 crl < not E, Sigma, Out > => < xraised(Vrz, Srz), Out' >
   if < E, Sigma, Out > => < xraised(Vrz, Srz), Out' > .
 crl < len(E), Sigma, Out > => < xraised(Vrz, Srz), Out' >
   if < E, Sigma, Out > => < xraised(Vrz, Srz), Out' > .

  --- ----- statements ----------------------------------------
  rl < pass, Sigma, Out > => < Sigma, Out > .

 crl < X := E, Sigma, Out > => CfgR
   if < E, Sigma, Out > => < EO, Out' >
   /\ asgK(EO, X, Sigma, Out') => CfgR .
  op asgK : ExpOut Id State Out -> Configuration .
  rl asgK(V, X, Sigma, Out')                 => < asgn(Sigma, X, V), Out' > .
  rl asgK(xraised(V, Sigma1), X, Sigma, Out') => < raised(V, Sigma1), Out' > .

 crl < print(E), Sigma, Out > => CfgR
   if < E, Sigma, Out > => < EO, Out' >
   /\ printK(EO, Sigma, Out') => CfgR .
  op printK : ExpOut State Out -> Configuration .
  rl printK(V, Sigma, Out')                 => < Sigma, Out' :: V > .
  rl printK(xraised(V, Sigma1), Sigma, Out') => < raised(V, Sigma1), Out' > .

  --- xs.append[v]: rebind xs to xs + [v] [pure-value lists; no aliasing in v1]
 crl < X .append(E), Sigma, Out > => CfgR
   if listV(L) := Sigma(X)
   /\ < E, Sigma, Out > => < EO, Out' >
   /\ appK(EO, X, L, Sigma, Out') => CfgR .
  op appK : ExpOut Id ListObj State Out -> Configuration .
  rl appK(V, X, L, Sigma, Out')                 => < mutd(Sigma, X, listV(lstAppend(L, V))), Out' > .
  rl appK(xraised(V, Sigma1), X, L, Sigma, Out') => < raised(V, Sigma1), Out' > .

  --- xs[i] = v: rebind xs to a copy with element i replaced
 crl < X [E1] := E2, Sigma, Out > => < mutd(Sigma, X, listV(lstSet(L, I, V))), Out2 >
   if listV(L) := Sigma(X)
   /\ < E1, Sigma, Out  > => < I, Out1 >
   /\ < E2, Sigma, Out1 > => < V, Out2 >
   /\ I >=Int 0 /\ I <Int lstLen(L) .
  --- a raise from either index or value expression propagates [cycle 14]
 crl < X [E1] := E2, Sigma, Out > => < raised(V, Sigma1), Out1 >
   if < E1, Sigma, Out > => < xraised(V, Sigma1), Out1 > .
 crl < X [E2] := E1, Sigma, Out > => < raised(V, Sigma1), Out2 >
   if < E2, Sigma, Out > => < V2, Out1 >
   /\ < E1, Sigma, Out1 > => < xraised(V, Sigma1), Out2 > .

  op lstSet : ListObj Int Value -> ListObj .
  vars Vh Vha : Value .  vars Lh : ListObj .
  eq lstSet(cons(Vha, Lh), 0, Vh) = cons(Vh, Lh) .
 ceq lstSet(cons(Vha, Lh), I, Vh) = cons(Vha, lstSet(Lh, I -Int 1, Vh))
   if I >Int 0 .

  --- ----- sequence: normal flow OR early return ------------
  vars Outc Outc1 Outc2 : Outcome .

  --- Cycle 13: ONE rule per construct.  The old shape had one rule per
  --- outcome of St1 [normal / ret / raised / brk / cnt], and each rule
  --- re-ran St1 inside its condition, so every nesting level multiplied the
  --- work by ~20.  Now St1 runs once, and a helper op dispatches on the
  --- Outcome by pattern [exactly one of its rules can apply].
  op seqK : Outcome Stmt Out -> Configuration .
  vars Outd : Outcome .
  --- normal flow: S2 runs in the State S1 produced.
 crl seqK(Sigma1, St2, Out1) => < Outc2, Out2 >
   if < St2, Sigma1, Out1 > => < Outc2, Out2 > .
  --- ret / raised / brk / cnt in S1 short-circuit: S2 is skipped.
  rl seqK(ret(V, SigmaR), St2, Out1) => < ret(V, SigmaR), Out1 > .
  rl seqK(raised(V, Sigma1), St2, Out1) => < raised(V, Sigma1), Out1 > .
  rl seqK(brk(Sigma1), St2, Out1) => < brk(Sigma1), Out1 > .
  rl seqK(cnt(Sigma1), St2, Out1) => < cnt(Sigma1), Out1 > .
 crl < St1 ; St2, Sigma, Out > => < Outc2, Out2 >
   if < St1, Sigma, Out > => < Outd, Out1 >
   /\ seqK(Outd, St2, Out1) => < Outc2, Out2 > .

  --- break / continue [cycle 12]: carry the State at the jump.
 rl < breakStmt,    Sigma, Out > => < brk(Sigma), Out > .
 rl < continueStmt, Sigma, Out > => < cnt(Sigma), Out > .

  --- if uses truthy[_] to match Python's "any value can be a condition"
 crl < ifelse(E){ St1 }else{ St2 }, Sigma, Out > => CfgR
   if < E, Sigma, Out > => < EO, Out1 >
   /\ ifK(EO, St1, St2, Sigma, Out1) => CfgR .
  --- cycle 14: the condition may raise; the raise propagates.
  op ifK : ExpOut Stmt Stmt State Out -> Configuration .
 crl ifK(V, St1, St2, Sigma, Out1) => < Outc1, Out2 >
   if truthy(V) ==Bool true
   /\ < St1, Sigma, Out1 > => < Outc1, Out2 > .
 crl ifK(V, St1, St2, Sigma, Out1) => < Outc2, Out2 >
   if truthy(V) ==Bool false
   /\ < St2, Sigma, Out1 > => < Outc2, Out2 > .
  rl ifK(xraised(V, Sigma1), St1, St2, Sigma, Out1) => < raised(V, Sigma1), Out1 > .

  --- while [cycle 13: one rule; the body runs once per iteration].
  op whileK  : Bool Exp Stmt State Out -> Configuration .   --- condition value decided
  op whileB  : Outcome Exp Stmt Out -> Configuration .      --- body outcome decided
 crl < while(E){ St }, Sigma, Out > => CfgR
   if < E, Sigma, Out > => < EO, Out1 >
   /\ whileC(EO, E, St, Sigma, Out1) => CfgR .
  --- cycle 14: the condition may raise; the raise propagates.
  op whileC  : ExpOut Exp Stmt State Out -> Configuration .
  rl whileC(V, E, St, Sigma, Out1) => whileK(truthy(V), E, St, Sigma, Out1) .
  rl whileC(xraised(V, Sigma1), E, St, Sigma, Out1) => < raised(V, Sigma1), Out1 > .
  --- condition false -> exit normally.
  rl whileK(false, E, St, Sigma, Out1) => < Sigma, Out1 > .
  --- condition true -> run the body once and dispatch on its outcome.
 crl whileK(true, E, St, Sigma, Out1) => < Outc2, Out3 >
   if < St, Sigma, Out1 > => < Outd, Out2 >
   /\ whileB(Outd, E, St, Out2) => < Outc2, Out3 > .
  --- body completed normally, or hit continue: test the condition again
  --- in the State at that point.
 crl whileB(Sigma1, E, St, Out2) => < Outc2, Out3 >
   if < while(E){ St }, Sigma1, Out2 > => < Outc2, Out3 > .
 crl whileB(cnt(Sigma1), E, St, Out2) => < Outc2, Out3 >
   if < while(E){ St }, Sigma1, Out2 > => < Outc2, Out3 > .
  --- body hit break: leave the loop normally in the State at the break.
  rl whileB(brk(Sigma1), E, St, Out2) => < Sigma1, Out2 > .
  --- body returned / raised: propagate.
  rl whileB(ret(V, SigmaR), E, St, Out2) => < ret(V, SigmaR), Out2 > .
  rl whileB(raised(V, Sigma1), E, St, Out2) => < raised(V, Sigma1), Out2 > .

  --- ----- functions: def / return / call ------------------
  vars IL : IdList .  vars Body : Stmt .  vars VL : ValueList .
  vars F : Exp .         --- function-position expression in callExp / callStmt
  vars SigmaB : State .  --- function body's resulting State (no-return path)
  vars Out0 OutA : Out . --- intermediate Out buffers in call evaluation
  vars Cap : State .     --- captured State at function-def time (cycle 6)

  --- def f[params]: body  -- bind f in current state to a function value.
 rl < def(X, IL, Body), Sigma, Out > => < asgn(Sigma, X, funcV(IL, Body, Sigma)), Out > .

  --- bare return  -->  return None
  rl < return, Sigma, Out > => < ret(none, Sigma), Out > .

  --- return e  -->  evaluate e, produce ret[V].
 crl < return(E), Sigma, Out > => CfgR
   if < E, Sigma, Out > => < EO, Out' >
   /\ retK(EO, Sigma, Out') => CfgR .
  op retK : ExpOut State Out -> Configuration .
  rl retK(V, Sigma, Out')          => < ret(V, Sigma), Out' > .
  rl retK(xraised(V, Sigma1), Sigma, Out') => < raised(V, Sigma1), Out' > .

  --- Helper: evaluate an ExpList left-to-right into a ValueList.
  op evalArgs : ExpList State Out -> Configuration .
  --- Cycle 14: an argument may raise [ArgsOut = ValueList or Raised].
  op argsK : ExpOut ExpList State Out -> Configuration .
   rl evalArgs(nilE, Sigma, Out) => < nilVL, Out > .
  crl evalArgs(consE(E, EL), Sigma, Out) => argsK(EO, EL, Sigma, Out1)
    if < E, Sigma, Out > => < EO, Out1 > .
  crl argsK(V, EL, Sigma, Out1) => < consVL(V, VL), Out2 >
    if evalArgs(EL, Sigma, Out1) => < VL, Out2 > .
  crl argsK(V, EL, Sigma, Out1) => < xraisedL(V2, Sigma2), Out2 >
    if evalArgs(EL, Sigma, Out1) => < xraisedL(V2, Sigma2), Out2 > .
   rl argsK(xraised(V, Sigma1), EL, Sigma, Out1) => < xraisedL(V, Sigma1), Out1 > .

  --- Helper: pair an IdList with a ValueList into a State [frame].
  op buildFrame : IdList ValueList -> State .
  vars Xb : Id .  vars ILb : IdList .  vars Vb : Value .  vars VLb : ValueList .
  eq buildFrame(nilI, nilVL) = .State .
  eq buildFrame(consI(Xb, ILb), consVL(Vb, VLb))
    = (Xb |-> Vb) & buildFrame(ILb, VLb) .
  --- mismatched arg count: undefined frame [arity-mismatch surface error
  --- deferred to cycle 7].

  --- Call frame [cycle 14]: the caller's State (without its frame markers),
  --- plus the captured bindings it lacks, with the parameters set LAST so a
  --- parameter that shadows a caller or captured variable reads the argument.
  op setFrame : State IdList ValueList -> State .
  eq setFrame(Sigma, nilI, nilVL) = Sigma .
  eq setFrame(Sigma, consI(Xb, ILb), consVL(Vb, VLb)) = setFrame(Sigma[Vb / Xb], ILb, VLb) .
  op mkFrame : State State IdList ValueList -> State .
  eq mkFrame(Sigma, Cap, IL, VL)
    = (markParams(setFrame(fill(stripMarks(Sigma), Cap, Cap, Sigma), IL, VL), IL))[true / fnFlag] .
  op markParams : State IdList -> State .
  eq markParams(Sigma, nilI) = Sigma .
  eq markParams(Sigma, consI(Xb, ILb)) = markParams(Sigma[true / prm(Xb)], ILb) .

  --- Write-back [cycle 14]: lists are pure values, so a callee that appended
  --- to / set an element of a list works on its own copy.  After a call
  --- STATEMENT, copy such a list back to the caller: (a) a parameter whose
  --- argument is a plain variable, (b) a variable the callee did not assign
  --- locally and the caller has.  Calls in expression position do not copy
  --- back [the expression result has no State].
  op inIds : Id IdList -> Bool .
  eq inIds(X, nilI) = false .
  eq inIds(X, consI(Xb, ILb)) = (X ==Bool Xb) orBool inIds(X, ILb) .
  op wbParams : State IdList ExpList State -> State .
  vars Ewa : Id .  vars ELa : ExpList .
  eq wbParams(Sigma, nilI, ELa, SigmaF) = Sigma .
  eq wbParams(Sigma, consI(Xb, ILb), nilE, SigmaF) = Sigma .
 ceq wbParams(Sigma, consI(Xb, ILb), consE(Ewa, ELa), SigmaF)
   = wbParams(mutd(Sigma, Ewa, SigmaF(Xb)), ILb, ELa, SigmaF)
   if (SigmaF(mut(Xb)) ==Bool true) andBool (SigmaF(loc(Xb)) =/=Bool true) .
  eq wbParams(Sigma, consI(Xb, ILb), consE(E, ELa), SigmaF)
   = wbParams(Sigma, ILb, ELa, SigmaF) [owise] .
  op wbG : State State IdList State -> State .
  vars Y : Id .
 ceq wbG(Sigma, (mut(Y) |-> V) & Sigma2, IL, SigmaF)
   = wbG(mutd(Sigma, Y, SigmaF(Y)), Sigma2, IL, SigmaF)
   if (inIds(Y, IL) =/=Bool true) andBool (SigmaF(loc(Y)) =/=Bool true) andBool bound(Sigma, Y) .
  eq wbG(Sigma, (Y |-> V) & Sigma2, IL, SigmaF) = wbG(Sigma, Sigma2, IL, SigmaF) [owise] .
  eq wbG(Sigma, .State, IL, SigmaF) = Sigma .
  op wb : State IdList ExpList State -> State .
  eq wb(Sigma, IL, ELa, SigmaF) = wbG(wbParams(Sigma, IL, ELa, SigmaF), SigmaF, IL, SigmaF) .

  --- Function call as expression [cycle 13: one rule; the body runs once].
  --- Body returned a value -> that value.  Body completed normally -> None.
  --- Body raised -> the exception propagates [the caller's own State, since
  --- the callee's frame is discarded].  Anything the callee could not
  --- finish by break / continue is not a call result and stays stuck.
  --- Cycle 14: an argument that raises propagates too.
  op callRes : Outcome State Out -> Configuration .
  rl callRes(ret(V, SigmaR), Sigma, Out2)    => < V, Out2 > .
  rl callRes(Sigma1, Sigma, Out2)            => < none, Out2 > .
  rl callRes(raised(V, Sigma1), Sigma, Out2) => < xraised(V, Sigma), Out2 > .
 crl < callExp(F, EL), Sigma, Out > => CfgR
   if < F, Sigma, Out > => < funcV(IL, Body, Cap), Out0 >
   /\ evalArgs(EL, Sigma, Out0) => < AO, OutA >
   /\ callExpGo(AO, IL, Body, Cap, Sigma, OutA) => CfgR .
  op callExpGo : ArgsOut IdList Stmt State State Out -> Configuration .
 crl callExpGo(VL, IL, Body, Cap, Sigma, OutA) => CfgR
   if < Body, mkFrame(Sigma, Cap, IL, VL), OutA > => < Outd, Out2 >
   /\ callRes(Outd, Sigma, Out2) => CfgR .
  rl callExpGo(xraisedL(V, Sigma1), IL, Body, Cap, Sigma, OutA) => < xraised(V, Sigma1), OutA > .

  --- callStmt: the value is discarded; a raise propagates as raised; list
  --- mutations in the callee are copied back [write-back above].
  op callStmtRes : Outcome State IdList ExpList Out -> Configuration .
  rl callStmtRes(Sigma1, Sigma, IL, ELa, Out2)            => < wb(Sigma, IL, ELa, Sigma1), Out2 > .
  rl callStmtRes(ret(V, SigmaR), Sigma, IL, ELa, Out2)    => < wb(Sigma, IL, ELa, SigmaR), Out2 > .
  rl callStmtRes(raised(V, Sigma1), Sigma, IL, ELa, Out2) => < raised(V, wb(Sigma, IL, ELa, Sigma1)), Out2 > .
 crl < callStmt(F, EL), Sigma, Out > => CfgR
   if < F, Sigma, Out > => < funcV(IL, Body, Cap), Out0 >
   /\ evalArgs(EL, Sigma, Out0) => < AO, OutA >
   /\ callStmtGo(AO, IL, EL, Body, Cap, Sigma, OutA) => CfgR .
  op callStmtGo : ArgsOut IdList ExpList Stmt State State Out -> Configuration .
 crl callStmtGo(VL, IL, ELa, Body, Cap, Sigma, OutA) => CfgR
   if < Body, mkFrame(Sigma, Cap, IL, VL), OutA > => < Outd, Out2 >
   /\ callStmtRes(Outd, Sigma, IL, ELa, Out2) => CfgR .
  rl callStmtGo(xraisedL(V, Sigma1), IL, ELa, Body, Cap, Sigma, OutA) => < raised(V, Sigma1), OutA > .

  --- ----- exceptions: raise / try-except ----------------
  --- raise e: evaluate e, propagate as raised[V, State at the raise] [cycle 13].
 crl < raise(E), Sigma, Out > => CfgR
   if < E, Sigma, Out > => < EO, Out' >
   /\ raiseK(EO, Sigma, Out') => CfgR .
  op raiseK : ExpOut State Out -> Configuration .
  rl raiseK(V, Sigma, Out')                 => < raised(V, Sigma), Out' > .
  rl raiseK(xraised(V, Sigma1), Sigma, Out') => < raised(V, Sigma1), Out' > .

  --- try { body } except as x { handler }   [cycle 13: one rule]
  --- The body runs once.  Normal completion, ret, break and continue pass
  --- through untouched; a raise binds the exception to x and runs the
  --- handler in the State at the raise.
  op tryK : Outcome Id Stmt Out -> Configuration .
 crl < tryexcept(Body, X, St1), Sigma, Out > => < Outc, Out2 >
   if < Body, Sigma, Out > => < Outd, Out1 >
   /\ tryK(Outd, X, St1, Out1) => < Outc, Out2 > .
  rl tryK(Sigma1, X, St1, Out1)      => < Sigma1, Out1 > .
  rl tryK(ret(V, SigmaR), X, St1, Out1) => < ret(V, SigmaR), Out1 > .
  rl tryK(brk(Sigma1), X, St1, Out1) => < brk(Sigma1), Out1 > .
  rl tryK(cnt(Sigma1), X, St1, Out1) => < cnt(Sigma1), Out1 > .
 crl tryK(raised(V, Sigma1), X, St1, Out1) => < Outc, Out2 >
   if < St1, asgn(Sigma1, X, V), Out1 > => < Outc, Out2 > .

  --- ----- tuples [cycle 8] ----------------------------------
  --- tupLit(...) — same eval as listLit but wraps in tupV instead of listV.
 crl < tupLit(EL), Sigma, Out > => < tupV(L), Out' >
   if evalElts(EL, Sigma, Out) => < L, Out' > .

  --- len(t) for tuples [shares lstLen with lists].
 crl < len(E), Sigma, Out > => < lstLen(L), Out' >
   if < E, Sigma, Out > => < tupV(L), Out' > .

  --- t ! i  for tuples [same indexing op as lists].
 crl < E1 ! E2, Sigma, Out > => < lstIdx(L, I), Out2 >
   if < E1, Sigma, Out  > => < tupV(L), Out1 >
   /\ < E2, Sigma, Out1 > => < I, Out2 >
   /\ I >=Int 0
   /\ I <Int lstLen(L) .

  --- Multi-assignment: a, b, ... = e   where e -> tupV(L) or listV(L).
  --- Bind each id in IdList to the corresponding element of L; arity
  --- mismatch leaves the assignment stuck [v2 will surface a ValueError].
  op spreadAssign : State IdList ListObj -> State .
  vars Xs : Id .  vars ILs : IdList .  vars Vs : Value .  vars Ls : ListObj .
  eq spreadAssign(Sigma, nilI, nil) = Sigma .
  eq spreadAssign(Sigma, consI(Xs, ILs), cons(Vs, Ls))
    = spreadAssign(asgn(Sigma, Xs, Vs), ILs, Ls) .

 crl < multiAssign(IL, E), Sigma, Out > => < spreadAssign(Sigma, IL, L), Out' >
   if < E, Sigma, Out > => < tupV(L), Out' > .
 crl < multiAssign(IL, E), Sigma, Out > => < spreadAssign(Sigma, IL, L), Out' >
   if < E, Sigma, Out > => < listV(L), Out' > .

  --- ----- lambda [cycle 10] --------------------------------
  --- lambdaExp(params, body)  evaluates to funcV(params, return(body), Sigma)
  --- where Sigma is the current state (closure-equivalent behaviour).
 rl < lambdaExp(IL, E), Sigma, Out > => < funcV(IL, return(E), Sigma), Out > .

  --- None literal evaluates to the none value.
 rl < noneE, Sigma, Out > => < none, Out > .

  --- ----- slicing [cycle 11] -------------------------------
  --- xs[a:b]  with  a, b  either Int or none.  Negative indices are
  --- Python-style: len + i.  Out-of-range bounds are clamped.
  --- A literal `:` with no bound -> none.  Step (3rd arg of slice3)
  --- must be 1 in v1; non-1 step deferred.
  op clampSliceStart : Value Int -> Int .
  op clampSliceStop  : Value Int -> Int .
  op normIdx : Int Int -> Int .   --- normIdx(i, n): negative -> n+i, then clamp [0..n]
  --- Variables are declared before first use (Maude requires this).
  vars Sa Sb : Int .  vars Va Vb Vs : Value .  vars Ea Eb Es E0 : Exp .
  --- normIdx via conditional equations (the built-in if_then_else_fi
  --- is not regular over our Int/Value sorts and failed preregularity).
 ceq normIdx(Ih, Nh) = 0                if Ih <Int 0 /\ Ih +Int Nh <Int 0 .
 ceq normIdx(Ih, Nh) = Ih +Int Nh       if Ih <Int 0 /\ Ih +Int Nh >=Int 0 .
 ceq normIdx(Ih, Nh) = Nh               if Ih >=Int 0 /\ Ih >Int Nh .
 ceq normIdx(Ih, Nh) = Ih               if Ih >=Int 0 /\ Ih <=Int Nh .
  eq clampSliceStart(none, Nh) = 0 .
  eq clampSliceStart(Ih, Nh) = normIdx(Ih, Nh) .
  eq clampSliceStop(none, Nh) = Nh .
  eq clampSliceStop(Ih, Nh) = normIdx(Ih, Nh) .

  --- Slice on list.
 crl < slice3(E0, Ea, Eb, Es), Sigma, Out > => < listV(lstSlice(L, Sa, Sb)), Out3 >
   if < E0, Sigma, Out  > => < listV(L), Out1 >
   /\ < Ea, Sigma, Out1 > => < Va, Out2 >
   /\ < Eb, Sigma, Out2 > => < Vb, Out3 >
   /\ < Es, Sigma, Out3 > => < Vs, Out3 >
   /\ Sa := clampSliceStart(Va, lstLen(L)) 
   /\ Sb := clampSliceStop(Vb, lstLen(L)) .
  --- [step Es is ignored in v1; only the no-step / step-1 case is correct]

  --- Slice on tuple.
 crl < slice3(E0, Ea, Eb, Es), Sigma, Out > => < tupV(lstSlice(L, Sa, Sb)), Out3 >
   if < E0, Sigma, Out  > => < tupV(L), Out1 >
   /\ < Ea, Sigma, Out1 > => < Va, Out2 >
   /\ < Eb, Sigma, Out2 > => < Vb, Out3 >
   /\ < Es, Sigma, Out3 > => < Vs, Out3 >
   /\ Sa := clampSliceStart(Va, lstLen(L)) 
   /\ Sb := clampSliceStop(Vb, lstLen(L)) .

  --- Slice on string.
 crl < slice3(E0, Ea, Eb, Es), Sigma, Out > => < substr(S, Sa, maxInt(Sb -Int Sa, 0)), Out3 >
   if < E0, Sigma, Out  > => < S, Out1 >
   /\ < Ea, Sigma, Out1 > => < Va, Out2 >
   /\ < Eb, Sigma, Out2 > => < Vb, Out3 >
   /\ < Es, Sigma, Out3 > => < Vs, Out3 >
   /\ Sa := clampSliceStart(Va, length(S))
   /\ Sb := clampSliceStop(Vb, length(S)) .

  --- String indexing s[i] returns a 1-character string (CPython).
 crl < E1 ! E2, Sigma, Out > => < substr(S, Sa, 1), Out2 >
   if < E1, Sigma, Out  > => < S, Out1 >
   /\ < E2, Sigma, Out1 > => < Ih, Out2 >
   /\ Sa := normIdx(Ih, length(S)) .

  --- ----- dicts [cycle 9] ----------------------------------
  --- dict literal: evaluate keys and values left-to-right.
  op evalDEntries : DictEntries State Out -> Configuration .
  op <_,_> : DictObj Out -> Configuration [ctor] .
  vars DE : DictEntries .  vars D : DictObj .
  vars Vk Vd : Value .
   rl evalDEntries(nilDE, Sigma, Out) => < nilD, Out > .
  crl evalDEntries(consDE(E1, E2, DE), Sigma, Out) => < consD(Vk, Vd, D), Out3 >
    if < E1, Sigma, Out  > => < Vk, Out1 >
    /\ < E2, Sigma, Out1 > => < Vd, Out2 >
    /\ evalDEntries(DE, Sigma, Out2) => < D, Out3 > .

 crl < dictLit(DE), Sigma, Out > => < dictV(D), Out' >
   if evalDEntries(DE, Sigma, Out) => < D, Out' > .

  --- dict subscript get: d ! k.
 crl < E1 ! E2, Sigma, Out > => < dictGet(D, Vk), Out2 >
   if < E1, Sigma, Out  > => < dictV(D), Out1 >
   /\ < E2, Sigma, Out1 > => < Vk, Out2 > .

  --- dict subscript set: d[k] = v.  Reuses the `_[_]:=_` Stmt op.
 crl < X [E1] := E2, Sigma, Out > => < Sigma[dictV(dictSet(D, Vk, Vd)) / X], Out2 >
   if dictV(D) := Sigma(X)
   /\ < E1, Sigma, Out  > => < Vk, Out1 >
   /\ < E2, Sigma, Out1 > => < Vd, Out2 > .

  --- len(d) for dicts.
 crl < len(E), Sigma, Out > => < dictLen(D), Out' >
   if < E, Sigma, Out > => < dictV(D), Out' > .

  --- k in d  membership check [dict only — list/string `in` future].
 crl < E1 in E2, Sigma, Out > => < dictHas(D, Vk), Out2 >
   if < E1, Sigma, Out  > => < Vk, Out1 >
   /\ < E2, Sigma, Out1 > => < dictV(D), Out2 > .

  --- ----- whole-program kickoff -----------------------------
  --- The program may end either with a State or with a ret[V] [if
  --- the program has a top-level return].  Both are Outcome.
 crl < St > => < Sigma, Out >
   if < St, .State, .Out > => < Sigma, Out > .       --- normal completion
 crl < St > => < .State, Out >
   if < St, .State, .Out > => < ret(V, SigmaR), Out > .      --- top-level return; we
                                                     --- discard the returned
                                                     --- value [Python's main
                                                     --- shouldn't return non-None].
endm
